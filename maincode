  if(code==='over_email_send_rate_limit'||/email rate limit exceeded/i.test(message))return '验证邮件发送太频繁。请先使用已收到的邮件确认；普通登录请点「登录」，不必重复注册。';
  if(code==='email_not_confirmed'||/email not confirmed/i.test(message))return '邮箱尚未确认。请打开验证邮件完成确认，然后回来登录。';
  if(code==='email_address_not_authorized')return '默认邮件服务暂不支持向这个邮箱发信，请联系项目管理员配置邮件服务。';
  if(code==='invalid_credentials')return '邮箱或密码不正确，请检查后重新登录。';
  return message;
