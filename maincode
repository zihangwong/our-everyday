async function makeMediaPreview(blob,m){
  if(!document.createElement||typeof Image==='undefined')return null;
  var source,url=URL.createObjectURL(blob),timer;
  try{
    if(m.kind==='video'){
      source=document.createElement('video');source.muted=true;source.playsInline=true;source.preload='auto';
      await new Promise(function(resolve,reject){timer=setTimeout(function(){reject(Error('无法生成视频封面'));},9000);source.onloadeddata=function(){clearTimeout(timer);resolve();};source.onerror=function(){clearTimeout(timer);reject(Error('视频编码暂不支持预览'));};source.src=url;});
      m.duration=Number.isFinite(source.duration)?source.duration:0;m.width=source.videoWidth;m.height=source.videoHeight;
    }else{
      source=new Image();source.src=url;await source.decode();m.width=source.naturalWidth;m.height=source.naturalHeight;
    }
    var size=previewDimensions(m.width,m.height,640);if(!size)return null;
    var canvas=document.createElement('canvas');canvas.width=size.width;canvas.height=size.height;canvas.getContext('2d').drawImage(source,0,0,size.width,size.height);
    return await new Promise(function(resolve){canvas.toBlob(resolve,'image/jpeg',.79);});
  }finally{clearTimeout(timer);if(source&&m.kind==='video'){source.pause();source.removeAttribute('src');source.load();}URL.revokeObjectURL(url);}
}
