  finally{cloudBusy=false;cloudOperation='';renderCloudUI();}
}
async function cloudPull(force){
  if(cloudBusy||!backend.space||(!backend.ready&&!force))return;
  if(backend.dirty&&!force){await cloudPush();return;}
  cloudBusy=true;cloudOperation='read';
  try{var client=await getSupabase(),result=await client.from('diary_state').select('document,revision').eq('diary_id',backend.space).single();if(result.error)throw result.error;
    if(backend.dirty&&!force){scheduleCloudPush();return;}
    if(!result.data.document){backend.status='空间还是空的；可手动上传这台设备的内容。';backend.revision=Number(result.data.revision);persistBackend();renderCloudUI();return;}
    if(force||Number(result.data.revision)>backend.revision){var next=normalizeState(result.data.document),old=state;state=next;if(!persistConfigOnly()){state=old;throw Error('本机存储不可用');}backend.revision=Number(result.data.revision);backend.ready=true;backend.dirty=false;await hydrateMedia();renderAll();}
    backend.status='';persistBackend();renderCloudUI();
