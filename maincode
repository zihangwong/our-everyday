async function optimizeArchivePreviews(){
  if(previewMaintenanceBusy||!backend.ready)return;previewMaintenanceBusy=true;
  var button=document.getElementById('optimizePreviews'),status=document.getElementById('previewMaintenanceStatus');button.disabled=true;
  var list=allMedia().filter(function(m){return !m.previewCloud;}),done=0,failed=0;
  try{
    for(var item of list){
      status.textContent='正在准备轻量预览 '+(done+failed+1)+' / '+list.length+'，原图会完整保留。';
      var blob=item.localKey?await assetStore('readonly',item.localKey):null;
      try{
        if(!blob){var response=await fetch(mediaURL(item));if(!response.ok)throw Error('原图暂未载入');blob=await response.blob();}
        var d=state.dates.find(function(x){return x.id===item.dateId;});if(!d)continue;if(!Array.isArray(d.media)){d.media=recordMedia(d).map(cleanMedia);d.photos=[];}var m=d.media.find(function(x){return x.id===item.id;});if(!m)continue;
        if(m.previewLocalKey&&await assetStore('readonly',m.previewLocalKey)){done++;continue;}
        if(await storeMediaPreview(blob,m))done++;else failed++;
      }catch(e){failed++;}
      await new Promise(function(resolve){setTimeout(resolve,15);});
    }
    if(done){if(!save())throw Error('本机预览信息没有保存成功');await cloudPush();renderAll();}
