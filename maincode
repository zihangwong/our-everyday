function previewDimensions(width,height,maxEdge){
  var w=Number(width),h=Number(height);if(!Number.isFinite(w)||!Number.isFinite(h)||w<=0||h<=0)return null;
  var scale=Math.min(1,(maxEdge||640)/Math.max(w,h));return {width:Math.max(1,Math.round(w*scale)),height:Math.max(1,Math.round(h*scale))};
