/* The space owner and partner are identities, not choices in a letter form. */
var letterSending=false,letterAttempt=null;
function currentLetterIdentity(){
  if(!backend.user||!backend.ownerId||!backend.space)return null;
  var who=backend.user===backend.ownerId?'my':'her';
  return {id:backend.user,who:who,name:who==='my'?(state.config.myName||'我'):(state.config.herName||'你'),recipient:who==='my'?(state.config.herName||'你'):(state.config.myName||'我')};
}
async function loadLetterIdentity(client,diaryId){
  var result=await client.from('diaries').select('owner_id').eq('id',diaryId).single();
  if(result.error)throw result.error;
  if(!result.data||typeof result.data.owner_id!=='string')throw Error('暂时无法确认书信署名，请重新进入空间。');
  backend.ownerId=result.data.owner_id;persistBackend();
}
function updateLetterComposer(){
  var label=document.getElementById('letterSender');if(!label)return;
  var identity=currentLetterIdentity();label.textContent=identity?identity.name:'登录后自动署名';
  document.getElementById('letterRecipient').textContent=identity?'写给 '+identity.recipient:'';
  var send=document.getElementById('letterSend');send.disabled=letterSending||!backend.ready||!identity;send.textContent=letterSending?'正在送出…':'留下这封信';
  document.getElementById('msgText').disabled=letterSending;document.getElementById('sbLogout').disabled=letterSending;
}
function letterWho(message){
  if(message.authorId&&backend.ownerId)return message.authorId===backend.ownerId?'my':'her';
  return message.who==='my'?'my':'her';
}
function applySentLetter(result,stamp){
  if(!result||!result.message||result.message.authorId!==backend.user||!result.document||!Number.isSafeInteger(Number(result.revision)))throw Error('送信结果还没有确认，文字已保留，请重试。');
  var edited=state.meta.updatedAt!==stamp;
  if(!edited){state=normalizeState(result.document);backend.revision=Number(result.revision);backend.dirty=false;state.meta.pendingCloud=false;}
  else{
    if(!state.messages.some(function(m){return m.id===result.message.id;}))state.messages.push(result.message);
    backend.dirty=true;state.meta.pendingCloud=true;
    if(!result.replayed)backend.revision=Number(result.revision);
  }
  if(edited&&result.replayed)backend.status='信已送出。这台设备还有未同步修改，请先备份再载入空间更新。';else backend.status='';
  var stored=persistConfigOnly();persistBackend();return {localStored:stored,needsSync:edited&&!result.replayed};
}
async function sendAuthenticatedLetter(){
  if(letterSending)return;
  var input=document.getElementById('msgText'),status=document.getElementById('letterStatus'),text=input.value.trim();
  if(!text){status.textContent='先写点内容再送出吧。';input.focus();return;}
  if(text.length>500){status.textContent='这封信最多500字。';return;}
  letterSending=true;updateLetterComposer();status.textContent='正在确认署名，送出这封信…';
  var ownsCloudLock=false,needsSync=false;
  try{
    var client=await getSupabase();
    if(!backend.ready||!backend.space||!currentLetterIdentity())throw Error('请先重新进入两人空间，再送出这封信。');
    if(cloudBusy)throw Error('空间正在同步，文字会留在这里，请稍后再送出。');
    if(backend.dirty&&!await cloudPush())throw Error(backend.status||'本机修改尚未同步，文字已保留。');
    if(backend.dirty||cloudBusy)throw Error('还有内容正在同步，文字会留在这里，请稍后再送出。');
    if(!letterAttempt||letterAttempt.user!==backend.user||letterAttempt.text!==text)letterAttempt={id:crypto.randomUUID(),user:backend.user,text:text};
    var stamp=state.meta.updatedAt;
    cloudBusy=true;cloudOperation='letter';ownsCloudLock=true;renderCloudUI();
    var response=await client.rpc('append_diary_letter',{p_id:backend.space,p_revision:backend.revision,p_message_id:letterAttempt.id,p_text:text});
    if(response.error)throw response.error;
    var saved=applySentLetter(response.data,stamp);needsSync=saved.needsSync;
    input.value='';document.getElementById('letterCharCount').textContent='0';letterAttempt=null;
    renderMessages();renderHome();status.textContent=saved.localStored?'已送到两人空间，署名是 '+response.data.message.authorName+'。':'信已经送到两人空间。本机存储未完成，请勿重复发送。';
    toast('这封信，已经送到了');
  }catch(e){
    if(/DIARY_CONFLICT/.test(e.message||'')){
      if(ownsCloudLock){cloudBusy=false;cloudOperation='';ownsCloudLock=false;}
      if(!backend.dirty)await cloudPull();
      status.textContent=backend.status||'对方刚有新记录，空间已更新。你的文字还在，请再点一次送出。';
    }else status.textContent=backendErrorMessage(e);
  }finally{
    if(ownsCloudLock){cloudBusy=false;cloudOperation='';}
    letterSending=false;updateLetterComposer();renderCloudUI();if(needsSync)scheduleCloudPush();
  }
}


