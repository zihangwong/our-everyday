  var preview=await makeMediaPreview(blob,m);if(!preview)return false;
  var key=m.id+'-preview';await assetStore('readwrite',key,preview);m.previewLocalKey=key;
  var old=mediaCache.get(m.id+':preview');if(old&&old.startsWith('blob:'))URL.revokeObjectURL(old);
  mediaCache.set(m.id+':preview',URL.createObjectURL(preview));return true;
}
var draftFiles=new Map(),cloudTransfer={done:0,total:0,name:''},previewMaintenanceBusy=false;
function queueDraftMedia(m,file,generation){
  pendingPhotos++;m.error='';m.status='等待保存';document.getElementById('dateSave').disabled=true;draftFiles.set(m.id,file);
  mediaWork=mediaWork.catch(function(){}).then(async function(){
    if(generation!==photoGeneration)return;
