/* Modal focus follows the active overlay, traps Tab and returns to its opener. */
var activeDialog = null;
var modalOpener = null;
var lastTrigger = null;
var backgroundInert = new Map();
document.addEventListener("click", function(e){
  if(!activeDialog) lastTrigger = e.target.closest("button,a,[tabindex]");
}, true);
function dialogFocusables(dialog){
  return Array.from(dialog.querySelectorAll('button:not([disabled]),a[href],input:not([disabled]):not([type="hidden"]),select,textarea,[tabindex="0"]')).filter(function(el){ return el.getClientRects().length && !el.closest("[hidden]"); });
}
function syncDialogFocus(){
  var next = document.querySelector(".onboard.open") || document.querySelector(".proposal-overlay.open") || Array.from(document.querySelectorAll(".modal.open")).pop() || null;
  if(next === activeDialog) return;
  if(next){
    if(!activeDialog) modalOpener = lastTrigger || document.activeElement;
    activeDialog = next;
    document.body.style.overflow = "hidden";
    Array.from(document.body.children).forEach(function(el){
      if(el === next || el.contains(next) || el.id === "toastWrap" || el.tagName === "SCRIPT") return;
      if(!backgroundInert.has(el)) backgroundInert.set(el, el.inert);
      el.inert = true;
    });
    next.inert = false;
    if(!next.contains(document.activeElement)){
      var target = dialogFocusables(next)[0];
      if(target) target.focus();
      else { next.tabIndex = -1; next.focus(); }
    }
  }else{
    activeDialog = null;
    backgroundInert.forEach(function(was, el){ el.inert = was; });
    backgroundInert.clear();
    document.body.style.overflow = "";
    var target = modalOpener && modalOpener.isConnected && modalOpener.getClientRects().length ? modalOpener : document.querySelector('.nav-link[aria-current="page"]');
    if(target) target.focus({preventScroll:true});
    modalOpener = null;
  }
}
var dialogObserver = new MutationObserver(function(){syncDialogFocus();if(!document.getElementById('recallModal').classList.contains('open'))document.querySelectorAll('#recallBody video').forEach(function(v){v.pause();});if(orbit)orbit.wake();});
document.querySelectorAll(".modal,.proposal-overlay,.onboard").forEach(function(el){ dialogObserver.observe(el, {attributes:true, attributeFilter:["class"]}); });
document.addEventListener("keydown", function(e){
  if(!activeDialog) return;
  if(e.key === "Escape"){
    e.preventDefault(); e.stopImmediatePropagation();
    if(activeDialog.id === "proposalOverlay") closeProposalOverlay();

    else if(activeDialog.id === "dateModal") closeDateModal();
    else activeDialog.classList.remove("open");
    return;
  }
  if(e.key === "Tab"){
    var items = dialogFocusables(activeDialog);
    if(!items.length){ e.preventDefault(); return; }
    var first = items[0], last = items[items.length - 1];
    if(e.shiftKey && (document.activeElement === first || !activeDialog.contains(document.activeElement))){ e.preventDefault(); last.focus(); }
    else if(!e.shiftKey && (document.activeElement === last || !activeDialog.contains(document.activeElement))){ e.preventDefault(); first.focus(); }
  }
}, true);


