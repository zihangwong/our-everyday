async function enterConnectedDiary(diaryId){
  var client=await getSupabase();
  if(!diaryId){
    var memberships=await client.from('diary_members').select('diary_id').eq('user_id',backend.user).limit(1).maybeSingle();
    if(memberships.error)throw memberships.error;
    if(!memberships.data)throw Error('这个账号还没有连接到两人空间。');
    diaryId=memberships.data.diary_id;
  }
  if(backend.space&&backend.space!==diaryId&&(backend.dirty||state.meta.pendingCloud))throw Error('这台设备有未同步的回忆，请先保留备份再切换空间。');
  var sameSpace=backend.space===diaryId;
  backend.space=diaryId;persistBackend();
  if(typeof loadLetterIdentity==='function')await loadLetterIdentity(client,diaryId);
  if(sameSpace&&backend.ready){
    await hydrateMedia();renderAll();if(state.meta.pendingCloud)backend.dirty=true;await cloudPull();
  }else{
    if(state.meta.pendingCloud)throw Error('这台设备有未同步的回忆，请先保留备份再切换空间。');
    backend.ready=false;backend.revision=0;backend.dirty=false;await cloudPull(true);
  }
  /* Only an album that never loaded keeps the gate closed. A failed upload must not lock someone out of
     memories already on this device; backend.status keeps the error visible and the edit stays queued. */
  if(!backend.ready)throw Error(backend.status||'相册还没有载入，请重试。');
  hideEmailEntry();renderCloudUI();
}
async function submitEmailEntry(email){
  var normalized=String(email||'').trim().toLowerCase();
  if(!/^\S+@\S+\.\S+$/.test(normalized)||normalized.length>254)throw Error('请输入正确的邮箱。');
  /* Unsynced memories are protected in enterConnectedDiary, which refuses only a different space.
     Refusing here, before any sign-in, locked the original partner out of their own unsynced edits. */
  var response=await fetch(PUBLIC_DIARY_CONFIG.url+'/functions/v1/email-entry',{method:'POST',headers:{'Content-Type':'application/json','apikey':PUBLIC_DIARY_CONFIG.key},body:JSON.stringify({email:normalized}),credentials:'omit',cache:'no-store'});
  var result;try{result=await response.json();}catch(e){throw Error('入口暂时没有响应，请稍后重试。');}
  if(!response.ok)throw Error(result.error||'这个邮箱暂时不能进入。');
  if(!result.session||typeof result.session.access_token!=='string'||typeof result.session.refresh_token!=='string'||!/^[0-9a-f-]{36}$/i.test(result.diary_id||''))throw Error('登录尚未建立，请重试。');
  var client=await getSupabaseClient(),signed=await client.auth.setSession({access_token:result.session.access_token,refresh_token:result.session.refresh_token});
  if(signed.error)throw signed.error;
  await enterConnectedDiary(result.diary_id);
}
