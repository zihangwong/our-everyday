      m.status='保存到这台设备…';renderPhotoPre();await assetStore('readwrite',m.localKey,file);
      if(generation!==photoGeneration){await assetStore('readwrite',m.localKey,null);return;}
      var old=mediaCache.get(m.id);if(old&&old.startsWith('blob:'))URL.revokeObjectURL(old);mediaCache.set(m.id,URL.createObjectURL(file));
      try{await storeMediaPreview(file,m);}catch(e){/* Original media remains usable if its browser cannot make a preview. */}
      if(generation!==photoGeneration){await assetStore('readwrite',m.localKey,null);if(m.previewLocalKey)await assetStore('readwrite',m.previewLocalKey,null);[m.id,m.id+':preview'].forEach(function(key){var url=mediaCache.get(key);if(url&&url.startsWith('blob:'))URL.revokeObjectURL(url);mediaCache.delete(key);});return;}
