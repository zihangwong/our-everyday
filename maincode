  try{var client=await getSupabase(),document=await prepareCloudDocument(client,sharedState());if(space!==backend.space)throw Error('空间已改变，请重试');
    var result=await client.rpc('save_diary',{p_id:space,p_revision:revision,p_document:document});if(result.error)throw result.error;
    backend.revision=Number(result.data);backend.status='';
    // Uploaded descriptors can be reused even if a newer local edit happened meanwhile.
    document.dates.forEach(function(d){var current=state.dates.find(function(x){return x.id===d.id;});if(current){var items=recordMedia(current);items.forEach(function(m){var sent=d.media.find(function(v){return v.id===m.id;});if(sent&&sent.cloud){m.cloud=sent.cloud;if(sent.localKey)m.localKey=sent.localKey;if(sent.previewCloud)m.previewCloud=sent.previewCloud;if(sent.previewLocalKey)m.previewLocalKey=sent.previewLocalKey;['width','height','duration'].forEach(function(key){if(sent[key]!==undefined)m[key]=sent[key];});delete m.src;}});current.media=items;current.photos=[];}});
